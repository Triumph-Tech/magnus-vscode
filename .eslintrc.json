{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 6,
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "rules": {
    // Warn if tabs are used anywhere in a file.
    "no-tabs": "warn",
    // Warn if single quotes are used instead of double quotes.
    "quotes": [
      "warn",
      "double",
      {
        "avoidEscape": true,
        "allowTemplateLiterals": true
      }
    ],
    // Warn if semicolons are omitted.
    "semi": "off",
    "@typescript-eslint/semi": [
      "error",
      "always"
    ],
    // Warn about unused variables, unless they are prefixed with underscore.
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    // Allow things like `value: number = 5`.
    "@typescript-eslint/no-inferrable-types": "off",
    // Enforce return types be specified on functions.
    "@typescript-eslint/explicit-function-return-type": [
      1,
      {
        "allowExpressions": true
      }
    ],
    // Disable JavaScript brace-style in favor of TypeScript support. This
    // brace style matches our C# style.
    "brace-style": "off",
    "@typescript-eslint/brace-style": [
      "warn",
      "stroustrup"
    ],
    // Make unwanted white-space inside parenthesis an error.
    "space-in-parens": [
      "error",
      "never"
    ],
    // Require all members to specify private/public/protected.
    "@typescript-eslint/explicit-member-accessibility": "error",
    // Require all block statements to use curly braces.
    "curly": "error",
    // Require all condition checks to use === or !== instead of == and !=.
    "eqeqeq": "error",
    // Do not allow throwing literal strings.
    "no-throw-literal": "warn",
    // Enforce certain naming conventions on all code.
    // `while (true)` with an internal exit is the clearest way to write a
    // worker pulling from a shared cursor (see asyncUtils.ts). The rule still
    // catches genuinely constant `if` conditions, which is the case worth
    // catching.
    "no-constant-condition": [
      "error",
      {
        "checkLoops": false
      }
    ],
    "@typescript-eslint/naming-convention": [
      "error",
      // By default everything will use camelCase unless otherwise noted below.
      {
        "selector": "default",
        "format": [
          "camelCase"
        ]
      },
      // Variables and parameters that are unused may also be prefixed with an underscore.
      {
        "selector": [
          "variable",
          "parameter"
        ],
        "format": [
          "camelCase"
        ],
        "modifiers": [
          "unused"
        ],
        "leadingUnderscore": "allow"
      },
      // Module-level constants may be UPPER_CASE. The local-mode code uses this
      // convention throughout (MANIFEST_VERSION, FETCH_CONCURRENCY,
      // SKIP_TREE_URI_PATTERNS, …); this config predated that code and rejected
      // all of them, so `npm run lint` reported 17 errors that were never
      // actionable and trained everyone to ignore the error count.
      {
        "selector": [
          "variable"
        ],
        "modifiers": [
          "const"
        ],
        "format": [
          "camelCase",
          "PascalCase",
          "UPPER_CASE"
        ]
      },
      // Variables that are exported may use camelCase, PascalCase or UPPER_CASE.
      {
        "selector": [
          "variable"
        ],
        "format": [
          "camelCase",
          "PascalCase",
          "UPPER_CASE"
        ],
        "modifiers": [
          "exported"
        ]
      },
      // Enum members should be PascalCase as it is similar to a type.
      {
        "selector": [
          "enumMember"
        ],
        "format": [
          "PascalCase"
        ]
      },
      // Interfaces must be prefixed with a capital I.
      {
        "selector": [
          "interface"
        ],
        "format": [
          "PascalCase"
        ],
        "prefix": [
          "I"
        ]
      },
      // Allow object literals {} to use any naming since we often use
      // these to pass data to 3rd party libraries and don't have a choice.
      {
        "selector": [
          "objectLiteralProperty",
          "objectLiteralMethod"
        ],
        "format": null
      },
      // Any type-like definitions (types, classes, interfaces, enums, etc.)
      // must be PascalCase.
      {
        "selector": "typeLike",
        "format": [
          "PascalCase"
        ]
      }
    ],
    // Allow non-null assertions. Developer should know what they are doing.
    "@typescript-eslint/no-non-null-assertion": "off"
  },
  "ignorePatterns": [
    "out",
    "dist",
    "**/*.d.ts",
    "webpack.config.js"
  ]
}
